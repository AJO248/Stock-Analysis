# Copy this file to .env and fill in your own values.
# Only OPENAI_API_KEY and FINNHUB_API_KEY are required to get started;
# everything else has a sensible default in config.py.

# --- Chat LLM (OpenAI-compatible endpoint) ---
# Used for article summarization and the AI Assistant chat.
OPENAI_API_KEY=your_openai_api_key_here
# Point this at any OpenAI-compatible chat completions endpoint (e.g. near.ai).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# --- Local embeddings (RAG) ---
# Downloaded and run locally via sentence-transformers - no API key needed.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- News data source ---
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Feature toggles ---
# Set to "false" to disable the RAG/AI Assistant pipeline entirely.
RAG_ENABLED=true

# --- Scraper behavior ---
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPING_DELAY=1.5

# --- Cache durations (seconds) ---
STOCK_CACHE_DURATION=300
NEWS_CACHE_DURATION=3600
SUMMARY_CACHE_DURATION=86400

# --- Storage paths (defaults live under ./data) ---
DB_PATH=data/news_cache.db
VECTOR_STORE_PATH=data/vector_store

# --- Logging ---
LOG_LEVEL=INFO
